<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty name="serviceName" source="service.name" defaultValue="unknown"/>

    <!-- JSON to console (single-line per event, tailed by Alloy into Loki).
         Logs intentionally do NOT go over OTLP anymore; only traces do. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- v8 removed `additionalFields`; `customFields` injects a raw JSON
                 object into every event. ${serviceName} is resolved by logback
                 from the <springProperty> above (application.yaml service.name). -->
            <customFields>{"service.name":"${serviceName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>